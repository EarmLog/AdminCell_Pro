# ============================================================================
#  Variables de entorno de AdminCell Pro
# ----------------------------------------------------------------------------
#  Esta aplicación NO usa Supabase ni autenticación: es de uso directo y
#  trabaja 100% con base de datos local (Dexie en Web, SQLite en Tauri/Android).
#  Estas variables son opcionales y sirven solo para personalizar la app.
# ============================================================================

# Nombre visible de la aplicación
NEXT_PUBLIC_APP_NOMBRE="AdminCell Pro"

# Nombre del archivo de base de datos SQLite en Escritorio/Android
NEXT_PUBLIC_DB_NOMBRE="admincell_pro"
